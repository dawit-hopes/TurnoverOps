# Neon PostgreSQL URL, for example:
# DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require
DATABASE_URL=sqlite:///./turnoverops.db
JWT_SECRET=replace-with-a-random-string-at-least-32-characters
JWT_TTL_MINUTES=720
GOOGLE_CLIENT_ID=
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_FRONTEND_URL=http://localhost:5173
DEV_MODE=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5173/integrations/google-calendar
# Add this backend callback URL to the same Google OAuth client as an authorized redirect URI.
CLEANER_GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/public/cleaner-calendar/callback
MAX_ASSIGNMENT_ATTEMPTS=3
CONFIRMATION_TIMEOUT_MINUTES=60
MAX_NOTIFICATION_RETRIES=3
NOTIFICATION_RETRY_SECONDS=60
ENABLE_SCHEDULER=true
SCHEDULER_INTERVAL_SECONDS=60
SCHEDULING_MODEL=gemini-2.5-flash
SCHEDULING_MAX_OUTPUT_TOKENS=2048
SCHEDULING_MAX_REPAIR_ATTEMPTS=2
SCHEDULING_TEMPERATURE=0
PLANNING_HORIZON_HOURS=2160
PLANNING_LOCK_MINUTES=15
EMAIL_FROM=
# Gmail SMTP. SMTP_PASSWORD is a Google App Password, not the Gmail account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
APP_BASE_URL=http://localhost:8000
APP_TIMEZONE=Africa/Addis_Ababa
# Optional cost estimates recorded on planning runs. Leave unset to store no cost.
# SCHEDULING_INPUT_USD_PER_MILLION=
# SCHEDULING_OUTPUT_USD_PER_MILLION=
